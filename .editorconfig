# EditorConfig — consistent whitespace across editors and agents.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ex,exs,heex}]
indent_size = 2

[*.{js,ts,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,rs}]
indent_size = 4

[Makefile]
indent_style = tab
